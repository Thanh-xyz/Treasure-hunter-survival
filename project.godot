; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="emberfield"
config/description="Portrait pixel action-survival RPG (offline vertical slice)"
run/main_scene="uid://dams7sdefx3c0"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CollisionLayers="*res://sense/globals/collision_layers.gd"
InteractionManager="*res://sense/components/interaction_manager.tscn"
GameEvent="*res://sense/globals/game_event.gd"
ItemDatabase="*res://sense/items/item_database.gd"
SceneTransitionService="*res://sense/globals/scene_transition_service.gd"
CameraService="*res://sense/globals/camera_service.gd"
RecipeDatabase="*res://sense/ui/crafting/recipe_database.gd"
SkillDatabase="*res://sense/skills/skill_database.gd"
NotificationManager="*res://sense/globals/notification_manager.gd"
ConfirmDialog="*res://sense/globals/confirm_dialog.gd"
GameState="*res://sense/globals/game_state.gd"
QuestService="*res://sense/globals/quest_service.gd"
SaveService="*res://sense/globals/save_service.gd"
LanSession="*res://sense/network/lan_session.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1600
window/size/window_width_override=360
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

