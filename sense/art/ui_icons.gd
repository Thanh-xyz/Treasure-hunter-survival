static var _cache: Dictionary = {}


static func names() -> Array:
	return ICONS.keys()


static func has_icon(name: String) -> bool:
	return ICONS.has(name)


## Icon at `scale`× (integer, nearest-neighbour). Cached per name and scale.
static func texture(name: String, scale: int = 1) -> Texture2D:
	var key := "%s@%d" % [name, scale]
	if _cache.has(key):
		return _cache[key]
	if not ICONS.has(name):
		return null
	var img := ArtPalette.image_from_rows(ICONS[name])
	if scale > 1:
		img = ArtPalette.upscale(img, scale)
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex
